// This config is in the KDL format: https://kdl.dev
// "/-" comments out the following node.
// Check the wiki for a full description of the configuration:
// https://yalter.github.io/niri/Configuration:-Introduction


// Input device configuration.
// Find the full list of options on the wiki:
// https://yalter.github.io/niri/Configuration:-Input
input {
    keyboard {
        xkb {
            // 显式指定布局，不依赖 locale1 (systemd-localed 在此系统上未常驻运行)
            layout "us"
        }

        // Enable numlock on startup, omitting this setting disables it.
        numlock
    }

    // Next sections include libinput settings.
    // Omitting settings disables them, or leaves them at their default values.
    // All commented-out settings here are examples, not defaults.
    touchpad {
        // off
        tap
        // dwt
        // dwtp
        // drag false
        // drag-lock
        natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "two-finger"
        // disabled-on-external-mouse
    }

    mouse {
        // off
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "no-scroll"
    }

    trackpoint {
        // off
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "on-button-down"
        // scroll-button 273
        // scroll-button-lock
        // middle-emulation
    }

    // Uncomment this to make the mouse warp to the center of newly focused windows.
    // warp-mouse-to-focus

    // Focus windows and outputs automatically when moving the mouse into them.
    // Setting max-scroll-amount="0%" makes it work only on windows already fully on screen.
    // focus-follows-mouse max-scroll-amount="0%"
}

// You can configure outputs by their name, which you can find
// by running `niri msg outputs` while inside a niri instance.
// The built-in laptop monitor is usually called "eDP-1".
// Find more information on the wiki:
// https://yalter.github.io/niri/Configuration:-Outputs
// Remember to uncomment the node by removing "/-"!
/-output "eDP-1" {
    // Uncomment this line to disable this output.
    // off

    // Resolution and, optionally, refresh rate of the output.
    // The format is "<width>x<height>" or "<width>x<height>@<refresh rate>".
    // If the refresh rate is omitted, niri will pick the highest refresh rate
    // for the resolution.
    // If the mode is omitted altogether or is invalid, niri will pick one automatically.
    // Run `niri msg outputs` while inside a niri instance to list all outputs and their modes.
    mode "1920x1080@120.030"

    // You can use integer or fractional scale, for example use 1.5 for 150% scale.
    scale 2

    // Transform allows to rotate the output counter-clockwise, valid values are:
    // normal, 90, 180, 270, flipped, flipped-90, flipped-180 and flipped-270.
    transform "normal"

    // Position of the output in the global coordinate space.
    // This affects directional monitor actions like "focus-monitor-left", and cursor movement.
    // The cursor can only move between directly adjacent outputs.
    // Output scale and rotation has to be taken into account for positioning:
    // outputs are sized in logical, or scaled, pixels.
    // For example, a 3840×2160 output with scale 2.0 will have a logical size of 1920×1080,
    // so to put another output directly adjacent to it on the right, set its x to 1920.
    // If the position is unset or results in an overlap, the output is instead placed
    // automatically.
    position x=1280 y=0
}

// Settings that influence how windows are positioned and sized.
// Find more information on the wiki:
// https://yalter.github.io/niri/Configuration:-Layout
layout {
    // Set gaps around windows in logical pixels.
    gaps 14

    // When to center a column when changing focus, options are:
    // - "never", default behavior, focusing an off-screen column will keep at the left
    //   or right edge of the screen.
    // - "always", the focused column will always be centered.
    // - "on-overflow", focusing a column will center it if it doesn't fit
    //   together with the previously focused column.
    center-focused-column "never"

    // You can customize the widths that "switch-preset-column-width" (Mod+R) toggles between.
    preset-column-widths {
        // Proportion sets the width as a fraction of the output width, taking gaps into account.
        // For example, you can perfectly fit four windows sized "proportion 0.25" on an output.
        // The default preset widths are 1/3, 1/2 and 2/3 of the output.
        proportion 0.33333
        proportion 0.5
        proportion 0.66667

        // Fixed sets the width in logical pixels exactly.
        // fixed 1920
    }

    // You can also customize the heights that "switch-preset-window-height" (Mod+Shift+R) toggles between.
    // preset-window-heights { }

    // You can change the default width of the new windows.
    default-column-width { proportion 0.5; }
    // If you leave the brackets empty, the windows themselves will decide their initial width.
    // default-column-width {}

    // By default focus ring and border are rendered as a solid background rectangle
    // behind windows. That is, they will show up through semitransparent windows.
    // This is because windows using client-side decorations can have an arbitrary shape.
    //
    // If you don't like that, you should uncomment `prefer-no-csd` below.
    // Niri will draw focus ring and border *around* windows that agree to omit their
    // client-side decorations.
    //
    // Alternatively, you can override it with a window rule called
    // `draw-border-with-background`.

    // You can change how the focus ring looks.
    focus-ring {
        // Uncomment this line to disable the focus ring.
        off

        // How many logical pixels the ring extends out from the windows.
        width 4

        // Colors can be set in a variety of ways:
        // - CSS named colors: "red"
        // - RGB hex: "#rgb", "#rgba", "#rrggbb", "#rrggbbaa"
        // - CSS-like notation: "rgb(255, 127, 0)", rgba(), hsl() and a few others.

        // Color of the ring on the active monitor.
        active-color "#80000000"

        // Color of the ring on inactive monitors.
        //
        // The focus ring only draws around the active window, so the only place
        // where you can see its inactive-color is on other monitors.
        inactive-color "#80000000"

        // You can also use gradients. They take precedence over solid colors.
        // Gradients are rendered the same as CSS linear-gradient(angle, from, to).
        // The angle is the same as in linear-gradient, and is optional,
        // defaulting to 180 (top-to-bottom gradient).
        // You can use any CSS linear-gradient tool on the web to set these up.
        // Changing the color space is also supported, check the wiki for more info.
        //
        // active-gradient from="#80c8ff" to="#c7ff7f" angle=45

        // You can also color the gradient relative to the entire view
        // of the workspace, rather than relative to just the window itself.
        // To do that, set relative-to="workspace-view".
        //
        // inactive-gradient from="#505050" to="#808080" angle=45 relative-to="workspace-view"
    }

    // You can also add a border. It's similar to the focus ring, but always visible.
    border {
        // The settings are the same as for the focus ring.
        // If you enable the border, you probably want to disable the focus ring.
        off


        width 4
        active-color "#99CCFF"
        inactive-color "#00000000"

        // Color of the border around windows that request your attention.
        urgent-color "#00000000"

        // Gradients can use a few different interpolation color spaces.
        // For example, this is a pastel rainbow gradient via in="oklch longer hue".
        //
        // active-gradient from="#e5989b" to="#ffb4a2" angle=45 relative-to="workspace-view" in="oklch longer hue"

        // inactive-gradient from="#505050" to="#808080" angle=45 relative-to="workspace-view"
    }

    // You can enable drop shadows for windows.
    shadow {
        // Uncomment the next line to enable shadows.
        on

        // By default, the shadow draws only around its window, and not behind it.
        // Uncomment this setting to make the shadow draw behind its window.
        //
        // Note that niri has no way of knowing about the CSD window corner
        // radius. It has to assume that windows have square corners, leading to
        // shadow artifacts inside the CSD rounded corners. This setting fixes
        // those artifacts.
        //
        // However, instead you may want to set prefer-no-csd and/or
        // geometry-corner-radius. Then, niri will know the corner radius and
        // draw the shadow correctly, without having to draw it behind the
        // window. These will also remove client-side shadows if the window
        // draws any.
        //
        // draw-behind-window true

        // You can change how shadows look. The values below are in logical
        // pixels and match the CSS box-shadow properties.

        // Softness controls the shadow blur radius.
        softness 30

        // Spread expands the shadow.
        spread 5

        // Offset moves the shadow relative to the window.
        offset x=0 y=5

        // You can also change the shadow color and opacity.
        color "#112"
    }

    // Struts shrink the area occupied by windows, similarly to layer-shell panels.
    // You can think of them as a kind of outer gaps. They are set in logical pixels.
    // Left and right struts will cause the next window to the side to always be visible.
    // Top and bottom struts will simply add outer gaps in addition to the area occupied by
    // layer-shell panels and regular gaps.
    struts {
        // left 64
        // right 64
        // top 64
        // bottom 64
    }
}

// Add lines like this to spawn processes at startup.
// Note that running niri as a session supports xdg-desktop-autostart,
// which may be more convenient to use.
// See the binds section below for more spawn examples.

// waybar 状态栏 (由 niri 直接启动，最可靠)
spawn-at-startup "waybar"
spawn-at-startup "fcitx5"
spawn-at-startup "swww-daemon"
// swaync 通知中心/控制面板 (CachyOS 风格)
// 装在 ~/.local: 绝对路径 + XDG_CONFIG_DIRS 让 swaync 找到系统 CSS (~/.local/etc/xdg/swaync/style.css)
//
// ⚠️ niri 的 `spawn` / `environment` 都**不**做变量展开, 但 **`spawn-sh` 会** ——
//    它走的是 `/bin/sh -c`。所以这一行用 $HOME 是安全的 (下面几处同理)。
spawn-sh-at-startup "XDG_CONFIG_DIRS=$HOME/.local/etc/xdg:/etc/xdg $HOME/.local/bin/swaync"
// swww 守护进程启动需要一点时间，稍等并重试避免竞态
spawn-sh-at-startup "sleep 0.5; for i in 1 2 3 4 5; do swww img /usr/share/backgrounds/user/__Main__.png --transition-type none && break; sleep 0.5; done"

// To run a shell command (with variables, pipes, etc.), use spawn-sh-at-startup:
// spawn-sh-at-startup "qs -c ~/source/qs/MyAwesomeShell"

hotkey-overlay {
    // Uncomment this line to disable the "Important Hotkeys" pop-up at startup.
    skip-at-startup
}

// Uncomment this line to ask the clients to omit their client-side decorations if possible.
// If the client will specifically ask for CSD, the request will be honored.
// Additionally, clients will be informed that they are tiled, removing some client-side rounded corners.
// This option will also fix border/focus ring drawing behind some semitransparent windows.
// After enabling or disabling this, you need to restart the apps for this to take effect.
// prefer-no-csd

// You can change the path where screenshots are saved.
// A ~ at the front will be expanded to the home directory.
// The path is formatted with strftime(3) to give you the screenshot date and time.
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// You can also set this to null to disable saving screenshots to disk.
// screenshot-path null

// Animation settings.
// The wiki explains how to configure individual animations:
// https://yalter.github.io/niri/Configuration:-Animations
animations {
    // Uncomment to turn off all animations.
    // off

    // Slow down all animations by this factor. Values below 1 speed them up instead.
    // slowdown 3.0
}

// Window rules let you adjust behavior for individual windows.
// Find more information on the wiki:
// https://yalter.github.io/niri/Configuration:-Window-Rules

// Work around WezTerm's initial configure bug
// by setting an empty default-column-width.
window-rule {
    // This regular expression is intentionally made as specific as possible,
    // since this is the default config, and we want no false positives.
    // You can get away with just app-id="wezterm" if you want.
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

// Open the Firefox picture-in-picture player as floating by default.
window-rule {
    // This app-id regular expression will work for both:
    // - host Firefox (app-id is "firefox")
    // - Flatpak Firefox (app-id is "org.mozilla.firefox")
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// Example: block out two password managers from screen capture.
// (This example rule is commented out with a "/-" in front.)
/-window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#

    block-out-from "screen-capture"

    // Use this instead if you want them visible on third-party screenshot tools.
    // block-out-from "screencast"
}

// Example: enable rounded corners for all windows.
// (This example rule is commented out with a "/-" in front.)
/-window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}



window-rule {
    geometry-corner-radius 10
}
window-rule {
    match app-id="^dev.zed.Zed$"
    geometry-corner-radius 10
    background-effect {
        blur true
    }
    opacity 0.9
}
window-rule {
    match app-id="^thunar$"
    background-effect {
        blur true
    }
    opacity 0.9
}
window-rule {
    match app-id="^kitty$"
    background-effect {
        blur true
    }
    opacity 0.9
}

layer-rule {
    match namespace="^launcher$"
    background-effect {
        blur true
    }
    geometry-corner-radius 10
    opacity 0.9
}
layer-rule {
    match namespace="^waybar$"
    background-effect {
        blur true
    }
    opacity 0.8
}
layer-rule {
    match namespace="^swaync-control-center$"
    background-effect {
        blur true
    }
    geometry-corner-radius 12
    opacity 0.95
}
layer-rule {
    match namespace="^swaync-notification-window$"
    background-effect {
        blur true
    }
    geometry-corner-radius 12
    opacity 0.95
}

window-rule {
    match app-id="org.xfce.mousepad" title=r"^/tmp/ocrshot\.txt - Mousepad$"
    background-effect {
        blur true
    }
    opacity 0.9
    open-floating true


}
window-rule {
    match app-id="^Emulator$"
    open-floating true
    geometry-corner-radius 29
    clip-to-geometry true

}




binds {
    // 快捷键由修饰键（用 + 号分隔）和末尾的 XKB 按键名组成。
    // 要查找特定按键的 XKB 名称，你可以使用像 wev 这样的程序。
    //
    // "Mod" 是一个特殊的修饰键，在 TTY（纯终端环境）中运行时等于 Super (Win键)，
    // 在作为 winit 窗口运行时等于 Alt。
    //
    // 这里绑定的大多数操作也可以通过命令行调用，例如 `niri msg action do-something`。

    // 基础操作
    Mod+Q repeat=false hotkey-overlay-title="关闭窗口" { close-window; }
    Mod+F hotkey-overlay-title="最大化栏" { maximize-column; }
    Mod+Shift+F hotkey-overlay-title="全屏窗口" { fullscreen-window; }
    Mod+C hotkey-overlay-title="居中窗口" { center-column; }

    // 常用应用
    Mod+T hotkey-overlay-title="打开终端 (Kitty)" { spawn "kitty"; }
    Mod+D hotkey-overlay-title="应用启动器 (Fuzzel)" { spawn "fuzzel"; }
    // 用 spawn-sh 而非 spawn: spawn 是直接 exec, 参数里的 $HOME 不会展开
    Mod+E hotkey-overlay-title="打开文件管理器" { spawn-sh "xdg-open \"$HOME\""; }

    // 应急终端绑定 (不依赖 Super 键)
    Ctrl+Alt+T hotkey-overlay-title="打开终端 (应急)" { spawn "kitty"; }

    // 控制面板 / 通知中心 (swaync)
    Mod+N hotkey-overlay-title="打开控制面板 (swaync)" { spawn-sh "$HOME/.local/bin/swaync-client -t -sw"; }

    // 系统功能
    // ocr.sh 来自本仓库的 scripts/ocr.sh, 按 README 的步骤装到下面这个位置:
    //     cp scripts/ocr.sh ~/Documents/_zshrc/ocr.sh
    // 没装的话按 Mod+S 会静默无反应; 不需要就整行删掉。
    // (同样因为 spawn 不展开变量, 这里用 spawn-sh)
    Mod+S hotkey-overlay-title="屏幕ocr" { spawn-sh "zsh \"$HOME/Documents/_zshrc/ocr.sh\""; }
    Mod+Shift+S hotkey-overlay-title="屏幕截图" { spawn-sh "grim -t ppm -g \"$(slurp)\" - | satty -f - 2>/dev/null"; }
    Mod+Shift+E hotkey-overlay-title="退出 Niri 会话" { quit; }

    // 布局调整
    Mod+R hotkey-overlay-title="切换预设宽度" { switch-preset-column-width; }
    Mod+V hotkey-overlay-title="切换浮动状态" { toggle-window-floating; }
    Mod+W hotkey-overlay-title="切换标签页模式" { toggle-column-tabbed-display; }

    // Mod-Shift-/ (通常等同于 Mod-?)
    // 显示重要快捷键列表面板。
    Mod+Shift+Slash hotkey-overlay-title="显示此快捷键帮助" { show-hotkey-overlay; }

    // 运行程序的建议绑定：终端、应用启动器、锁屏。
    Super+Alt+L hotkey-overlay-title="锁定屏幕 (hyprlock)" { spawn "hyprlock"; }

    // 使用 spawn-sh 运行 shell 命令。如果你需要管道、多条命令等，请使用此方法。
    // 注意：整个命令作为一个参数传递。它被原封不动地传递给 `sh -c`。
    // 例如，这是一个切换屏幕阅读器 (orca) 的标准绑定。
    Super+Alt+S allow-when-locked=true hotkey-overlay-title="切换屏幕阅读器" { spawn-sh "pkill orca || exec orca"; }

    // 针对 PipeWire & WirePlumber 的音量键映射示例。
    // allow-when-locked=true 属性使它们即使在会话锁定时也能工作。
    // 使用 spawn-sh 允许将多个参数与命令一起传递。
    // "-l 1.0" 将最大音量限制在 100%。
    XF86AudioRaiseVolume allow-when-locked=true hotkey-overlay-title="音量增加" { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+ -l 1.0"; }
    XF86AudioLowerVolume allow-when-locked=true hotkey-overlay-title="音量减少" { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-"; }
    XF86AudioMute        allow-when-locked=true hotkey-overlay-title="静音开关" { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     allow-when-locked=true hotkey-overlay-title="麦克风静音开关" { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    // 使用 playerctl 的媒体键映射示例。
    // 这将适用于任何启用 MPRIS 的媒体播放器。
    XF86AudioPlay        allow-when-locked=true hotkey-overlay-title="播放/暂停" { spawn-sh "playerctl play-pause"; }
    XF86AudioStop        allow-when-locked=true hotkey-overlay-title="停止播放" { spawn-sh "playerctl stop"; }
    XF86AudioPrev        allow-when-locked=true hotkey-overlay-title="上一曲" { spawn-sh "playerctl previous"; }
    XF86AudioNext        allow-when-locked=true hotkey-overlay-title="下一曲" { spawn-sh "playerctl next"; }

    // 针对 brightnessctl 的亮度键映射示例。
    XF86MonBrightnessUp   allow-when-locked=true hotkey-overlay-title="亮度增加" { spawn "brightnessctl" "--class=backlight" "set" "+10%"; }
    XF86MonBrightnessDown allow-when-locked=true hotkey-overlay-title="亮度减少" { spawn "brightnessctl" "--class=backlight" "set" "10%-"; }

    // 打开/关闭概览模式：工作区和窗口的缩小视图。
    // 你也可以将鼠标移到左上角的热区，或者在触摸板上用四指向上滑动。
    Mod+O repeat=false hotkey-overlay-title="切换概览视图" { toggle-overview; }

    // 焦点移动（方向键与 HJKL）
    Mod+Left  hotkey-overlay-title="向左聚焦列" { focus-column-left; }
    Mod+Down  hotkey-overlay-title="向下聚焦窗口" { focus-window-down; }
    Mod+Up    hotkey-overlay-title="向上聚焦窗口" { focus-window-up; }
    Mod+Right hotkey-overlay-title="向右聚焦列" { focus-column-right; }
    Mod+H     hotkey-overlay-title="向左聚焦列 (H)" { focus-column-left; }
    Mod+J     hotkey-overlay-title="向下聚焦窗口 (J)" { focus-window-down; }
    Mod+K     hotkey-overlay-title="向上聚焦窗口 (K)" { focus-window-up; }
    Mod+L     hotkey-overlay-title="向右聚焦列 (L)" { focus-column-right; }

    // 窗口/列移动
    Mod+Ctrl+Left  hotkey-overlay-title="向左移动列" { move-column-left; }
    Mod+Ctrl+Down  hotkey-overlay-title="向下移动窗口" { move-window-down; }
    Mod+Ctrl+Up    hotkey-overlay-title="向上移动窗口" { move-window-up; }
    Mod+Ctrl+Right hotkey-overlay-title="向右移动列" { move-column-right; }
    Mod+Ctrl+H     hotkey-overlay-title="向左移动列 (H)" { move-column-left; }
    Mod+Ctrl+J     hotkey-overlay-title="向下移动窗口 (J)" { move-window-down; }
    Mod+Ctrl+K     hotkey-overlay-title="向上移动窗口 (K)" { move-window-up; }
    Mod+Ctrl+L     hotkey-overlay-title="向右移动列 (L)" { move-column-right; }

    // 移动到首/尾
    Mod+Home hotkey-overlay-title="聚焦第一列" { focus-column-first; }
    Mod+End  hotkey-overlay-title="聚焦最后一列" { focus-column-last; }
    Mod+Ctrl+Home hotkey-overlay-title="移动列至首位" { move-column-to-first; }
    Mod+Ctrl+End  hotkey-overlay-title="移动列至末尾" { move-column-to-last; }

    // 显示器焦点移动
    Mod+Shift+Left  hotkey-overlay-title="聚焦左侧显示器" { focus-monitor-left; }
    Mod+Shift+Down  hotkey-overlay-title="聚焦下方显示器" { focus-monitor-down; }
    Mod+Shift+Up    hotkey-overlay-title="聚焦上方显示器" { focus-monitor-up; }
    Mod+Shift+Right hotkey-overlay-title="聚焦右侧显示器" { focus-monitor-right; }
    Mod+Shift+H     hotkey-overlay-title="聚焦左侧显示器 (H)" { focus-monitor-left; }
    Mod+Shift+J     hotkey-overlay-title="聚焦下方显示器 (J)" { focus-monitor-down; }
    Mod+Shift+K     hotkey-overlay-title="聚焦上方显示器 (K)" { focus-monitor-up; }
    Mod+Shift+L     hotkey-overlay-title="聚焦右侧显示器 (L)" { focus-monitor-right; }

    // 跨显示器移动列
    Mod+Shift+Ctrl+Left  hotkey-overlay-title="将列移至左侧显示器" { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down  hotkey-overlay-title="将列移至下方显示器" { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up    hotkey-overlay-title="将列移至上方显示器" { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right hotkey-overlay-title="将列移至右侧显示器" { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+H     hotkey-overlay-title="将列移至左侧显示器 (H)" { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J     hotkey-overlay-title="将列移至下方显示器 (J)" { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K     hotkey-overlay-title="将列移至上方显示器 (K)" { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L     hotkey-overlay-title="将列移至右侧显示器 (L)" { move-column-to-monitor-right; }

    // 工作区操作
    Mod+Page_Down      hotkey-overlay-title="聚焦下一个工作区" { focus-workspace-down; }
    Mod+Page_Up        hotkey-overlay-title="聚焦上一个工作区" { focus-workspace-up; }
    Mod+U              hotkey-overlay-title="聚焦下一个工作区 (U)" { focus-workspace-down; }
    Mod+I              hotkey-overlay-title="聚焦上一个工作区 (I)" { focus-workspace-up; }
    Mod+Ctrl+Page_Down hotkey-overlay-title="将列移至下个工作区" { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   hotkey-overlay-title="将列移至上个工作区" { move-column-to-workspace-up; }
    Mod+Ctrl+U         hotkey-overlay-title="将列移至下个工作区 (U)" { move-column-to-workspace-down; }
    Mod+Ctrl+I         hotkey-overlay-title="将列移至上个工作区 (I)" { move-column-to-workspace-up; }

    Mod+Shift+Page_Down hotkey-overlay-title="向下移动工作区" { move-workspace-down; }
    Mod+Shift+Page_Up   hotkey-overlay-title="向上移动工作区" { move-workspace-up; }
    Mod+Shift+U         hotkey-overlay-title="向下移动工作区 (U)" { move-workspace-down; }
    Mod+Shift+I         hotkey-overlay-title="向上移动工作区 (I)" { move-workspace-up; }

    // 鼠标滚轮绑定（带冷却时间防误触）
    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }
    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }
    Mod+Shift+WheelScrollDown      { focus-column-right; }
    Mod+Shift+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

    // 数字键切换工作区
    Mod+1 hotkey-overlay-title="聚焦工作区 1" { focus-workspace 1; }
    Mod+2 hotkey-overlay-title="聚焦工作区 2" { focus-workspace 2; }
    Mod+3 hotkey-overlay-title="聚焦工作区 3" { focus-workspace 3; }
    Mod+4 hotkey-overlay-title="聚焦工作区 4" { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Ctrl+1 hotkey-overlay-title="将列移至工作区 1" { move-column-to-workspace 1; }
    Mod+Ctrl+2 hotkey-overlay-title="将列移至工作区 2" { move-column-to-workspace 2; }
    Mod+Ctrl+3 hotkey-overlay-title="将列移至工作区 3" { move-column-to-workspace 3; }
    Mod+Ctrl+4 hotkey-overlay-title="将列移至工作区 4" { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    // 吞并与排出窗口
    // 如果窗口单独成列，它会被吸收到相邻的列中。如果已经在列中，则会被排挤出去。
    Mod+BracketLeft  hotkey-overlay-title="向左吞并/排出窗口" { consume-or-expel-window-left; }
    Mod+BracketRight hotkey-overlay-title="向右吞并/排出窗口" { consume-or-expel-window-right; }

    // 从右侧将一个窗口吸收到当前列的底部。
    Mod+Comma  hotkey-overlay-title="从右侧吸收窗口至本列" { consume-window-into-column; }
    // 将当前列底部的窗口向右侧排挤出去。
    Mod+Period hotkey-overlay-title="将窗口从本列向右排出" { expel-window-from-column; }

    Mod+Shift+R hotkey-overlay-title="切换预设窗口高度" { switch-preset-window-height; }
    Mod+Ctrl+R hotkey-overlay-title="重置窗口高度" { reset-window-height; }

    // 展开当前列以填满其他完全可见列未占用的空间。（“填满剩余空间”）
    Mod+Ctrl+F hotkey-overlay-title="扩展列至可用宽度" { expand-column-to-available-width; }

    // 将屏幕上所有完全可见的列居中对齐。
    Mod+Ctrl+C hotkey-overlay-title="居中所有可见列" { center-visible-columns; }

    // 精细的宽度和高度调整
    Mod+Minus hotkey-overlay-title="减少列宽 10%" { set-column-width "-10%"; }
    Mod+Equal hotkey-overlay-title="增加列宽 10%" { set-column-width "+10%"; }
    Mod+Shift+Minus hotkey-overlay-title="减少窗口高度 10%" { set-window-height "-10%"; }
    Mod+Shift+Equal hotkey-overlay-title="增加窗口高度 10%" { set-window-height "+10%"; }

    // 将焦点在浮动层和分块(Tiling)层之间切换
    Mod+Shift+V hotkey-overlay-title="切换焦点 (浮动/分块)" { switch-focus-between-floating-and-tiling; }

    // 截图快捷键
    Print      hotkey-overlay-title="自由截图" { screenshot; }
    Ctrl+Print hotkey-overlay-title="全屏截图" { screenshot-screen; }
    Alt+Print  hotkey-overlay-title="窗口截图" { screenshot-window; }

    // 远程桌面客户端和软件 KVM 切换器可能会请求 Niri 停止处理键盘快捷键，
    // 以便将按键原样转发到远程机器。
    // 绑定一个“逃生舱”快捷键来切换抑制器是个好主意，这样可以防止出错的应用程序绑架你的会话。
    Mod+Escape allow-inhibiting=false hotkey-overlay-title="切换快捷键拦截" { toggle-keyboard-shortcuts-inhibit; }

    Ctrl+Alt+Delete hotkey-overlay-title="退出会话 (安全弹窗)" { quit; }

    // 关闭显示器电源。进行任何输入（如移动鼠标或按任意键）即可重新唤醒。
    Mod+Shift+P hotkey-overlay-title="关闭显示器电源" { power-off-monitors; }
}
